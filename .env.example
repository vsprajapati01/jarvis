# Copy this file to .env in the jarvis folder and fill in the keys you have.
# You only need ONE to start - Gemini is the easiest.
# Never paste keys in chat, never push .env to GitHub (.env is gitignored).
# Get free keys here:
#   Gemini:     https://aistudio.google.com  -> Get API key
#   Groq:       https://console.groq.com     -> API Keys (fastest)
#   Cerebras:   https://cloud.cerebras.ai   -> API Keys (1M free tokens/day)
#   OpenRouter: https://openrouter.ai       -> Keys (free :free models)
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE
GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE
CEREBRAS_API_KEY=PASTE_YOUR_CEREBRAS_KEY_HERE
OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_KEY_HERE
# Optional: change the OpenRouter free model if the default stops working.
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
